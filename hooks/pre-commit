#!/usr/bin/env bash
# Repo público: barra o commit se o diff staged tiver segredo (gitleaks) ou termo interno.
# Os termos ficam numa lista local fora do git (uma regex por linha), senão a própria lista vazaria.
# Falso positivo: git commit --no-verify.
set -euo pipefail

command -v gitleaks >/dev/null || { echo "pre-commit: instale o gitleaks (pacman -S gitleaks)" >&2; exit 1; }
gitleaks git --pre-commit --staged --redact --no-banner

terms=${DOTFILES_DENY_TERMS:-$HOME/.config/dotfiles/deny-terms}
[ -s "$terms" ] || exit 0
# só as linhas adicionadas: o awk pula o cabeçalho de cada arquivo (diff/index/---/+++) até o primeiro @@
if git diff --cached -U0 --diff-filter=ACMR | awk '/^diff --git/{h=1} /^@@/{h=0; next} !h && /^\+/' |
   grep -i -E -f <(grep -v -e '^#' -e '^$' "$terms"); then
  echo "pre-commit: termo interno no diff acima (lista em $terms)" >&2
  exit 1
fi
