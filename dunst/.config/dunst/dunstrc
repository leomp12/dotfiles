# dunst — notificações. Atalhos no hyprland.lua: SUPER+, fecha, SUPER+SHIFT+, histórico.
[global]
font = JetBrainsMono Nerd Font 10
origin = top-right
# a waybar já reserva o topo; 16px fica um pouco além do gaps_out (8) para não alinhar com a borda da janela do canto
offset = (16, 16)
width = 320
corner_radius = 6
frame_width = 2
frame_color = "#89b4fa"
separator_color = frame
gap_size = 6
padding = 8
horizontal_padding = 10
icon_position = left
max_icon_size = 32
history_length = 30
mouse_left_click = do_action, close_current
mouse_right_click = close_all

[urgency_low]
background = "#1e1e2e"
foreground = "#a6adc8"
timeout = 4

[urgency_normal]
background = "#1e1e2e"
foreground = "#cdd6f4"
timeout = 6

[urgency_critical]
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#f38ba8"
timeout = 0
